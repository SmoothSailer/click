# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase -----------------------------------------------------------
# Project URL: Supabase dashboard -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (server only, never expose this in the browser).
# Supabase dashboard -> Settings -> API -> Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access -------------------------------------------------------
# Password used on /admin/login. Use a long, random string.
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# WhatsApp -----------------------------------------------------------
# Business number in international format, digits only (no +, no spaces).
# Example: 919876543210 for +91 98765 43210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Public site details ------------------------------------------------
NEXT_PUBLIC_SITE_NAME=ClickEnergy
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_TAGLINE=Handpicked trucks, ready to earn.
NEXT_PUBLIC_CURRENCY=INR
# Number grouping locale. en-KE for 24,500,000 / en-IN for 24,50,000
NEXT_PUBLIC_LOCALE=en-IN

# Storage ------------------------------------------------------------
# Where uploaded photos are written. Defaults to ./storage/uploads
# UPLOAD_DIR=/var/www/trucks/uploads
